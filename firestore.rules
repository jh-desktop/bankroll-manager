rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isMember(wsId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email == 'yoonjea123123@gmail.com';
    }

    // ════════════════════════════════════════════════════════
    //  그라인더앱 (bankroll-manager)
    // ════════════════════════════════════════════════════════

    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    match /workspaces/{wsId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isMember(wsId) || isAdmin();

      match /members/{uid} {
        allow read: if isMember(wsId) || isAdmin();
        allow create: if isAuth() && (request.auth.uid == uid || isMember(wsId));
        allow delete: if isAuth() && (request.auth.uid == uid || isMember(wsId) || isAdmin());
        allow update: if isMember(wsId) || isAdmin();
      }

      match /records/{recordId} {
        allow read, write, delete: if isMember(wsId) || isAdmin();
      }

      match /history/{historyId} {
        allow read, write, delete: if isMember(wsId) || isAdmin();
      }

      match /posts/{postId} {
        allow read: if isMember(wsId) || isAdmin();
        allow create: if isMember(wsId);
        allow update, delete: if isMember(wsId) || isAdmin();

        match /comments/{commentId} {
          allow read: if isMember(wsId) || isAdmin();
          allow create: if isMember(wsId);
          allow update, delete: if isMember(wsId) || isAdmin();
        }
      }

      match /players/{playerId} {
        allow read, write, delete: if isMember(wsId) || isAdmin();
      }
    }

    match /admin_broadcasts/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /bankroll_fcm_tokens/{token} {
      allow read: if isAdmin();
      allow write: if isAuth();
    }

    // ════════════════════════════════════════════════════════
    //  스케줄매니저 (schedule-manager) — 인증 없이 사용
    // ════════════════════════════════════════════════════════

    match /employees/{id} {
      allow read, write, delete: if true;
    }

    match /schedules/{id} {
      allow read, write, delete: if true;
    }

    match /history/{id} {
      allow read, write, delete: if true;
    }

    match /events/{id} {
      allow read, write, delete: if true;
    }

    // ════════════════════════════════════════════════════════
    //  슬롯게임 (slot-game)
    // ════════════════════════════════════════════════════════

    match /slot_users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    match /withdrawal_requests/{id} {
      allow create: if isAuth();
      allow read, write, delete: if isAdmin();
    }
  }
}
